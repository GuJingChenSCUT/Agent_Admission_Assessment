        "label": "complete"
      },
      {
        "from": "approve",
        "to": "queue",
        "label": "exact approval"
      },
      {
        "from": "queue",
        "to": "ref",
        "label": ""
      },
      {
        "from": "ref",
        "to": "ready",
        "label": ""
      },
      {
        "from": "ready",
        "to": "quarantine",
        "label": "no"
      },
      {
        "from": "ready",
        "to": "admit",
        "label": "yes"
      },
      {
        "from": "admit",
        "to": "invoke",
        "label": "ALLOW"
      },
      {
        "from": "invoke",
        "to": "accept",
        "label": ""
      },
      {
        "from": "accept",
        "to": "success",
        "label": "yes"
      },
      {
        "from": "accept",
        "to": "fallback",
        "label": "no"
      },
      {
        "from": "admit",
        "to": "fallback",
        "label": "reject / unknown"
      },
      {
        "from": "fallback",
        "to": "admit",
        "label": "yes: next candidate"
      },
      {
        "from": "fallback",
        "to": "classify",
        "label": "no"
      },
      {
        "from": "classify",
        "to": "quarantine",
        "label": "yes"
      },
      {
        "from": "classify",
        "to": "failed",
        "label": "no"
      },
      {
        "from": "success",
        "to": "report",
        "label": ""
      },
      {
        "from": "failed",
        "to": "report",
        "label": ""
      },
      {
        "from": "quarantine",
        "to": "report",
        "label": ""
      }
    ],
    "rules": [
      "未支持的资产、链或交易请求在生成可批准范围前返回 UNSUPPORTED_SCOPE。",
      "切换不能增加预算、更改地址或改为 latest；参考冲突不能靠换候选绕过。",
      "遇到确定性禁止规则立即停止该路线；已识别攻击不应由模型解释后放行。"
    ],
    "groups": []
  },
  {
    "id": "D03",
    "title": "参考区块与数据验收",
    "scope": "原生 eth_getBalance 返回数量，不返回状态证明；请求绑定、服务声明和证明必须分开。",
    "nodes": [
      {
        "id": "scope",
        "label": "Approved chain + address",
        "meaning": "已批准 Ethereum 1 和地址",
        "kind": "process"
      },
      {
        "id": "a",
        "label": "Reference operator A",
        "meaning": "读取 chainId、finalized 头、目标区块和余额",
        "kind": "external"
      },
      {
        "id": "b",
        "label": "Reference operator B",
        "meaning": "不同运营者；不能仅以 URL 不同认定独立",
        "kind": "external"
      },
      {
        "id": "heads",
        "label": "Compatible finalized heads?",
        "meaning": "核对链、头偏差和可共同核对高度",
        "kind": "decision"
      },
      {
        "id": "hash",
        "label": "Same canonical block hash?",
        "meaning": "共同高度两边区块 hash 一致",
        "kind": "decision"
      },
      {
        "id": "balance",
        "label": "Same reference balance?",
        "meaning": "在固定 blockHash 对照两份余额",
        "kind": "decision"
      },
      {
        "id": "snapshot",
        "label": "Pin immutable Snapshot",
        "meaning": "保留区块、时间、来源、请求和响应摘要",
        "kind": "process"
      },
      {
        "id": "candidate",
        "label": "Parse candidate response",
        "meaning": "原件分别保留；校验 schema、范围和整数格式，失败不得进入验收",
        "kind": "process"
      },
      {
        "id": "binding",
        "label": "Binding kind?",
        "meaning": "区分原生 RPC 请求绑定与服务自行声明",
        "kind": "decision"
      },
      {
        "id": "rpc",
        "label": "REQUEST_BOUND",
        "meaning": "核对实际发送的区块参数；不能声称服务提供了证明",
        "kind": "process"
      },
      {
        "id": "declared",
        "label": "PROVIDER_DECLARED",
        "meaning": "检查服务声明的链、地址和区块是否相符",
        "kind": "process"
      },
      {
        "id": "compare",
        "label": "Compare exact wei",
        "meaning": "按本次参考值比较，不使用浮点",
        "kind": "decision"
      },
      {
        "id": "accepted",
        "label": "Required data checks PASS",
        "meaning": "仅返回已解析的验收结果给 D02；提交仍需 epochs 与租约守卫",
        "kind": "success"
      },
      {
        "id": "mismatch",
        "label": "Verification FAIL",
        "meaning": "确定的范围或数量失配；返回 D02 决定是否获准切换",
        "kind": "failure"
      },
      {
        "id": "quarantine",
        "label": "INCONCLUSIVE",
        "meaning": "冲突、来源不可用或必需能力不足",
        "kind": "wait"
      }
    ],
    "edges": [
      {
        "from": "scope",
        "to": "a",
        "label": ""
      },
      {
        "from": "scope",
        "to": "b",
        "label": ""
      },
      {
        "from": "a",
        "to": "heads",
        "label": ""
      },
      {
        "from": "b",
        "to": "heads",
        "label": ""
      },
      {
        "from": "heads",
        "to": "hash",
        "label": "yes"
      },
      {
        "from": "heads",
        "to": "quarantine",
        "label": "no"
      },
      {
        "from": "hash",
        "to": "balance",
        "label": "yes"
      },
      {
        "from": "hash",
        "to": "quarantine",
        "label": "no"
      },
      {
        "from": "balance",
        "to": "snapshot",
        "label": "yes"
      },
      {
        "from": "balance",
        "to": "quarantine",
        "label": "no"
      },
      {
        "from": "snapshot",
        "to": "candidate",
        "label": ""
      },
      {
        "from": "candidate",
        "to": "mismatch",
        "label": "malformed / wrong scope"
      },
      {
        "from": "candidate",
        "to": "binding",
        "label": "parsed"
      },
      {
        "from": "binding",
        "to": "rpc",
        "label": "raw RPC"
      },
      {
        "from": "binding",
        "to": "declared",
        "label": "enriched service"
      },
      {
        "from": "rpc",
        "to": "compare",
        "label": ""
      },
      {
        "from": "declared",
        "to": "compare",
        "label": "scope matches"
      },
      {
        "from": "declared",
        "to": "mismatch",
        "label": "scope mismatch"
      },
      {
        "from": "compare",
        "to": "accepted",
        "label": "equal"
      },
      {
        "from": "compare",
        "to": "mismatch",
        "label": "different"
      }
    ],
    "rules": [
      "原生 RPC 把旧值返回但恰与当前值相同，不能据此判断其内部使用了哪个区块；只记录可观察到的一致性。",
      "服务明确声明错误区块时拒绝该声明，并跳过跨区块金额比较；参考 RPC 交叉核对不等于密码学状态证明。",
      "finalized 的区块时间早于当前时间是正常情况；不以单一墙钟阈值把 finalized 判为过期。"
    ],
    "groups": []
  },
  {
    "id": "D04",
    "title": "准入与网络出口控制",
    "scope": "检查结果必须决定后端能否连接和提交，不能只作为 UI 分数。",
    "nodes": [
      {
        "id": "subject",
        "label": "Registered subject",
        "meaning": "固定命名空间、origin、transport、manifestHash",
        "kind": "process"
      },
      {
        "id": "egress",
        "label": "Egress policy",
        "meaning": "HTTPS、获准 origin、解析地址与重定向策略",
        "kind": "process"
      },
      {
        "id": "safe",
        "label": "Destination allowed?",
        "meaning": "连接目标是否仍在允许范围",
        "kind": "decision"
      },
      {
        "id": "reject",
        "label": "REJECT",
        "meaning": "明确禁止或确定失配；不得调用",
        "kind": "failure"
      },
      {
        "id": "checks",
        "label": "Capability + dependency checks",
        "meaning": "精确版本、完整公告页、声明来源类别",
        "kind": "process"
      },
      {
        "id": "required",
        "label": "Required evidence resolved?",
        "meaning": "必需检查是否具备可用结果",
        "kind": "decision"
      },
      {
        "id": "unknown",
        "label": "QUARANTINE",
        "meaning": "未知不是通过；可选未知单独展示",
        "kind": "wait"
      },
      {
        "id": "pass",
        "label": "Required checks PASS?",
        "meaning": "所有必需规则通过；无覆盖性禁用",
        "kind": "decision"
      },
      {
        "id": "ticket",
        "label": "Issue one-call ticket",
        "meaning": "绑定 spec、snapshot、policy、manifest、caller、epochs 和代际",
        "kind": "process"
      },
      {
        "id": "guard",
        "label": "Gateway guard",
        "meaning": "核验签名、当前权限、过期、预算与单次 jti",
        "kind": "process"
      },
      {
        "id": "dispatch",
        "label": "Atomic consume + dispatch",
        "meaning": "短事务登记消费、预算和逻辑调用开始",
        "kind": "process"
      },
      {
        "id": "call",
        "label": "Bounded provider call",
        "meaning": "无额外跟随重定向；限制时长、字节与解析深度",
        "kind": "process"
      },
      {
        "id": "result",
        "label": "Store response then verify",
        "meaning": "返回只作不可信数据；原件私有保存",
        "kind": "process"
      }
    ],
    "edges": [
      {
        "from": "subject",

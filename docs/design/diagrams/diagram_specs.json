[
  {
    "id": "D01",
    "title": "系统架构与信任边界",
    "scope": "区分模型建议、后端权限、外部服务和签名权限；箭头表示受控接口，不代表模型可直连。",
    "nodes": [
      {
        "id": "ui",
        "label": "User workspace",
        "meaning": "用户输入、补答、批准和停止；没有工具密钥",
        "kind": "process"
      },
      {
        "id": "control",
        "label": "Control API",
        "meaning": "认证、版本、批准、停止和当前任务状态",
        "kind": "process"
      },
      {
        "id": "agent",
        "label": "Planner agent",
        "meaning": "单个编排 Agent，只输出提案和解释",
        "kind": "external"
      },
      {
        "id": "db",
        "label": "Durable DB + outbox",
        "meaning": "任务真相、幂等、执行命令、租约与证据引用",
        "kind": "process"
      },
      {
        "id": "worker",
        "label": "Run worker",
        "meaning": "领取执行权并推进固定阶段",
        "kind": "process"
      },
      {
        "id": "inspect",
        "label": "Inspection + policy",
        "meaning": "静态依赖、清单、能力与 required 检查",
        "kind": "process"
      },
      {
        "id": "gateway",
        "label": "Execution gateway",
        "meaning": "凭据、停止 epoch、策略 epoch、租约代际和预算",
        "kind": "process"
      },
      {
        "id": "provider",
        "label": "Candidate services",
        "meaning": "管理员登记的两个候选；返回内容仍不可信",
        "kind": "external"
      },
      {
        "id": "reference",
        "label": "Reference resolver",
        "meaning": "两个配置上独立的 RPC 运营者、同一参考区块",
        "kind": "process"
      },
      {
        "id": "verify",
        "label": "Deterministic verifier",
        "meaning": "按明确规则核对范围、数量、请求区块与参考结果",
        "kind": "process"
      },
      {
        "id": "evidence",
        "label": "Evidence builder",
        "meaning": "私有原件与可公开报告；规范化与摘要",
        "kind": "process"
      },
      {
        "id": "publish",
        "label": "Publication worker",
        "meaning": "独立公开批准和持久登记命令",
        "kind": "process"
      },
      {
        "id": "signer",
        "label": "Restricted signer",
        "meaning": "固定链、合约、方法和预算；隔离密钥",
        "kind": "security"
      },
      {
        "id": "chain",
        "label": "BOT registry",
        "meaning": "登记事件、回执和当前主链核查",
        "kind": "external"
      },
      {
        "id": "ethid",
        "label": "Ethereum identity",
        "meaning": "GCC 主线的身份适配停点；当前未接入",
        "kind": "external"
      }
    ],
    "edges": [
      {
        "from": "ui",
        "to": "control",
        "label": "request / stop"
      },
      {
        "from": "control",
        "to": "agent",
        "label": "scope"
      },
      {
        "from": "agent",
        "to": "control",
        "label": "proposal"
      },
      {
        "from": "control",
        "to": "db",
        "label": "atomic state"
      },
      {
        "from": "db",
        "to": "worker",
        "label": "run command"
      },
      {
        "from": "worker",
        "to": "inspect",
        "label": "admission"
      },
      {
        "from": "inspect",
        "to": "gateway",
        "label": "decision"
      },
      {
        "from": "worker",
        "to": "reference",
        "label": "fixed snapshot"
      },
      {
        "from": "gateway",
        "to": "provider",
        "label": "bounded call"
      },
      {
        "from": "provider",
        "to": "verify",
        "label": "untrusted result"
      },
      {
        "from": "reference",
        "to": "verify",
        "label": "reference observations"
      },
      {
        "from": "verify",
        "to": "db",
        "label": "guarded fact commit"
      },
      {
        "from": "verify",
        "to": "evidence",
        "label": "checks + facts"
      },
      {
        "from": "evidence",
        "to": "publish",
        "label": "report + approval"
      },
      {
        "from": "control",
        "to": "publish",
        "label": "exact-hash consent"
      },
      {
        "from": "publish",
        "to": "signer",
        "label": "approved claim"
      },
      {
        "from": "signer",
        "to": "chain",
        "label": "persist then send"
      },
      {
        "from": "ethid",
        "to": "inspect",
        "label": "identity reference"
      }
    ],
    "rules": [
      "模型不持有 gateway ticket、私钥、服务令牌；gateway_invoke 不是模型工具。",
      "所有外部访问经过各自允许列表；参考源与候选源的独立性要有配置依据。",
      "Ethereum 数据链、Ethereum 身份位置与 BOT 登记链分别记录；图中的 Ethereum 身份节点是交付阻断项。"
    ],
    "groups": [
      {
        "name": "User surface",
        "nodes": [
          "ui"
        ]
      },
      {
        "name": "Control and persistence",
        "nodes": [
          "control",
          "db"
        ]
      },
      {
        "name": "Bounded runtime",
        "nodes": [
          "agent",
          "worker",
          "inspect",
          "gateway",
          "reference",
          "verify",
          "evidence"
        ]
      },
      {
        "name": "Signing boundary",
        "nodes": [
          "publish",
          "signer"
        ]
      }
    ]
  },
  {
    "id": "D02",
    "title": "任务主流程与终态",
    "scope": "主流程只描述一个已批准的只读任务；详细准入、停止和恢复分别见 D04、D06、D07。",
    "nodes": [
      {
        "id": "intent",
        "label": "User intent",
        "meaning": "用户提出原生 ETH 余额需求",
        "kind": "process"
      },
      {
        "id": "draft",
        "label": "Compile task scope",
        "meaning": "模型提案经后端 schema 与范围校验",
        "kind": "process"
      },
      {
        "id": "complete",
        "label": "Scope complete?",
        "meaning": "链、地址、资产、模式是否明确",
        "kind": "decision"
      },
      {
        "id": "clarify",
        "label": "NEEDS_INPUT",
        "meaning": "补答或选择唯一地址",
        "kind": "wait"
      },
      {
        "id": "approve",
        "label": "AWAITING_APPROVAL",
        "meaning": "展示范围、候选、限额、版本和摘要",
        "kind": "wait"
      },
      {
        "id": "queue",
        "label": "QUEUED",
        "meaning": "批准和 run outbox 在同一事务中提交",
        "kind": "process"
      },
      {
        "id": "ref",
        "label": "Resolve reference",
        "meaning": "固定参考区块并交叉核对",
        "kind": "process"
      },
      {
        "id": "ready",
        "label": "Reference agrees?",
        "meaning": "参考链、区块和余额能否闭合",
        "kind": "decision"
      },
      {
        "id": "admit",
        "label": "Admission check",
        "meaning": "检查当前候选的能力、来源和依赖",
        "kind": "process"
      },
      {
        "id": "invoke",
        "label": "Bounded invocation",
        "meaning": "网关准入与调用",
        "kind": "process"
      },
      {
        "id": "accept",
        "label": "Required checks PASS?",
        "meaning": "本次验收和提交守卫是否全部通过",
        "kind": "decision"
      },
      {
        "id": "fallback",
        "label": "Fallback still allowed?",
        "meaning": "同一范围、同一 Snapshot、剩余候选和预算",
        "kind": "decision"
      },
      {
        "id": "success",
        "label": "SUCCEEDED",
        "meaning": "只有通过验收的事实进入结果",
        "kind": "success"
      },
      {
        "id": "classify",
        "label": "Unknown evidence?",
        "meaning": "没有通过候选时，区分未知与确定失败",
        "kind": "decision"
      },
      {
        "id": "quarantine",
        "label": "QUARANTINED",
        "meaning": "必需证据未知或冲突，不能给可用事实",
        "kind": "wait"
      },
      {
        "id": "failed",
        "label": "FAILED",
        "meaning": "候选确定失败且无剩余获准路线",
        "kind": "failure"
      },
      {
        "id": "report",
        "label": "Immutable report",
        "meaning": "终态证据；公开登记另行批准",
        "kind": "process"
      }
    ],
    "edges": [
      {
        "from": "intent",
        "to": "draft",
        "label": ""
      },
      {
        "from": "draft",

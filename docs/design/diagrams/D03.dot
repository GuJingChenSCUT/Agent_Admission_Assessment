digraph D03 {
graph [rankdir=TB, bgcolor="#f8fafc", pad="0.30", nodesep="0.32", ranksep="0.52", splines=polyline, fontname="DejaVu Sans", fontsize=17, labelloc=t, label="D03  |  Reference and data verification"];
node [shape=box, style="rounded,filled", margin="0.15,0.12", fontname="DejaVu Sans", fontsize=12.5, fontcolor="#17304b", penwidth=1.15, width=1.95];
edge [color="#687e99", arrowsize=0.7, penwidth=1.05, fontname="DejaVu Sans", fontsize=10, fontcolor="#485f7a"];
scope [label="Approved chain + address", fillcolor="#ffffff", color="#94a8c2"];
a [label="Reference operator A", fillcolor="#f0f3f6", color="#8192a5"];
b [label="Reference operator B", fillcolor="#f0f3f6", color="#8192a5"];
heads [label="Compatible finalized\nheads?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
hash [label="Same canonical block\nhash?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
balance [label="Same reference balance?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
snapshot [label="Pin immutable Snapshot", fillcolor="#ffffff", color="#94a8c2"];
candidate [label="Parse candidate response", fillcolor="#ffffff", color="#94a8c2"];
binding [label="Binding kind?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
rpc [label="REQUEST_BOUND", fillcolor="#ffffff", color="#94a8c2"];
declared [label="PROVIDER_DECLARED", fillcolor="#ffffff", color="#94a8c2"];
compare [label="Compare exact wei", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
accepted [label="Required data checks\nPASS", fillcolor="#e9f6ee", color="#559b75"];
mismatch [label="Verification FAIL", fillcolor="#fcebed", color="#bd6876"];
quarantine [label="INCONCLUSIVE", fillcolor="#fff4df", color="#bd9651"];
scope -> a;
scope -> b;
a -> heads;
b -> heads;
heads -> hash [label="yes"];
heads -> quarantine [label="no"];
hash -> balance [label="yes"];
hash -> quarantine [label="no"];
balance -> snapshot [label="yes"];
balance -> quarantine [label="no"];
snapshot -> candidate;
candidate -> mismatch [label="malformed / wrong scope"];
candidate -> binding [label="parsed"];
binding -> rpc [label="raw RPC"];
binding -> declared [label="enriched service"];
rpc -> compare;
declared -> compare [label="scope matches"];
declared -> mismatch [label="scope mismatch"];
compare -> accepted [label="equal"];
compare -> mismatch [label="different"];
}
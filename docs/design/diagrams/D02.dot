digraph D02 {
graph [rankdir=TB, bgcolor="#f8fafc", pad="0.30", nodesep="0.32", ranksep="0.52", splines=polyline, fontname="DejaVu Sans", fontsize=17, labelloc=t, label="D02  |  Task lifecycle"];
node [shape=box, style="rounded,filled", margin="0.15,0.12", fontname="DejaVu Sans", fontsize=12.5, fontcolor="#17304b", penwidth=1.15, width=1.95];
edge [color="#687e99", arrowsize=0.7, penwidth=1.05, fontname="DejaVu Sans", fontsize=10, fontcolor="#485f7a"];
intent [label="User intent", fillcolor="#ffffff", color="#94a8c2"];
draft [label="Compile task scope", fillcolor="#ffffff", color="#94a8c2"];
complete [label="Scope complete?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
clarify [label="NEEDS_INPUT", fillcolor="#fff4df", color="#bd9651"];
approve [label="AWAITING_APPROVAL", fillcolor="#fff4df", color="#bd9651"];
queue [label="QUEUED", fillcolor="#ffffff", color="#94a8c2"];
ref [label="Resolve reference", fillcolor="#ffffff", color="#94a8c2"];
ready [label="Reference agrees?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
admit [label="Admission check", fillcolor="#ffffff", color="#94a8c2"];
invoke [label="Bounded invocation", fillcolor="#ffffff", color="#94a8c2"];
accept [label="Required checks PASS?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
fallback [label="Fallback still allowed?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
success [label="SUCCEEDED", fillcolor="#e9f6ee", color="#559b75"];
classify [label="Unknown evidence?", fillcolor="#edf3ff", color="#7399d7", shape=diamond, style=filled, margin="0.09,0.05", width=2.1];
quarantine [label="QUARANTINED", fillcolor="#fff4df", color="#bd9651"];
failed [label="FAILED", fillcolor="#fcebed", color="#bd6876"];
report [label="Immutable report", fillcolor="#ffffff", color="#94a8c2"];
intent -> draft;
draft -> complete;
complete -> clarify [label="missing"];
clarify -> draft [label="answer + revision"];
complete -> approve [label="complete"];
approve -> queue [label="exact approval"];
queue -> ref;
ref -> ready;
ready -> quarantine [label="no"];
ready -> admit [label="yes"];
admit -> invoke [label="ALLOW"];
invoke -> accept;
accept -> success [label="yes"];
accept -> fallback [label="no"];
admit -> fallback [label="reject / unknown"];
fallback -> admit [label="yes: next candidate"];
fallback -> classify [label="no"];
classify -> quarantine [label="yes"];
classify -> failed [label="no"];
success -> report;
failed -> report;
quarantine -> report;
}
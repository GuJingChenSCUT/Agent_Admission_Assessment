# Runtime mode is SAMPLE by default. LIVE fails closed until all sources are configured.
AA_EXECUTION_MODE=SAMPLE
AA_PORT=8787
AA_DATA_DIR=.data
AA_MAX_BODY_BYTES=1048576

# LIVE reference operators. Do not commit credentials or private URLs.
AA_REFERENCE_RPC_A=
AA_REFERENCE_RPC_B=

# Optional administrator-configured provider endpoints.
AA_PRIMARY_RPC=
AA_BACKUP_RPC=

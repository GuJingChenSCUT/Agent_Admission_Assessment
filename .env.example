# UI starts empty. Only an explicit approved LIVE task makes external queries.
AA_EXECUTION_MODE=LIVE
AA_ENABLE_LIVE=true
AA_PORT=8787
AA_DATA_DIR=.data
AA_MAX_BODY_BYTES=1048576

# Empty values use public defaults: PublicNode and dRPC. No SLA is promised.
# Credentials and private URLs belong only in .env (gitignored).
AA_REFERENCE_RPC_A=
AA_REFERENCE_RPC_B=
AA_REFERENCE_OPERATOR_A=
AA_REFERENCE_OPERATOR_B=

# Empty candidate values use reference A and B respectively (overlapping sources).
AA_PRIMARY_RPC=
AA_BACKUP_RPC=
AA_PRIMARY_OPERATOR=
AA_BACKUP_OPERATOR=
